DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# CORS is only needed when frontend and backend are on different origins.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:8080

DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=10485760

WHISPER_MODEL_SIZE=small
WHISPER_FALLBACK_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_MODEL_DIR=/models
WHISPER_ALLOWED_LANGUAGES=mk,en
WHISPER_CPU_THREADS=4
WHISPER_INITIAL_PROMPT_MK=Ова е снимка на македонски јазик.
WHISPER_TEMPERATURE=0.0
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
WHISPER_PATIENCE=2.0
WHISPER_COMPRESSION_RATIO_THRESHOLD=2.4
WHISPER_LOG_PROB_THRESHOLD=-1.0
WHISPER_NO_SPEECH_THRESHOLD=0.6

GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=600

# Optional Hugging Face token for fewer rate limits during model download.
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=

FRONTEND_PORT=8080
BACKEND_PORT=8000
